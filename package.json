{
  "scripts": {
    "clean": "npm prune && npm cache verify",
    "clear": "npm run clean",
    "format": "npx prettier **/*.{json,md,xml,yaml,yml} --write",
    "mcp": "npx @modelcontextprotocol/inspector",
    "ncu": "npx ncu"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.6.0",
    "@prettier/plugin-xml": "^3.4.2",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0"
  },
  "prettier": {
    "attributeSort": "ASC",
    "bracketSameLine": true,
    "plugins": [
      "@prettier/plugin-xml",
      "prettier-plugin-organize-attributes"
    ],
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "singleAttributePerLine": true
  },
  "allowScripts": {
    "@modelcontextprotocol/inspector": false
  }
}
